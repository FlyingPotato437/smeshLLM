# SmeshLLM Environment Variables
# Copy this file to .env.production and fill in your API keys

# === AI/LLM SERVICES ===
# OpenAI API (for RAG and hybrid services)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API (for main LLM and hybrid RAG)  
GEMINI_API_KEY=your_gemini_api_key_here

# === ENVIRONMENTAL DATA APIS ===
# OpenAQ API for real-time air quality data
# Sign up at: https://openaq.org/developers
OPENAQ_API_KEY=your_openaq_api_key_here

# NASA FIRMS API for fire detection data
# Get key at: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=your_nasa_firms_api_key_here

# Weather API (if using external weather service)
WEATHER_API_KEY=your_weather_api_key_here

# === SERVICE CONFIGURATION ===
PYTHON_SERVICE_URL=http://127.0.0.1:8000
HYBRID_RAG_SERVICE_URL=http://127.0.0.1:8000
